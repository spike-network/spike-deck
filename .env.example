# Chrome Web Store API (v2). Copy to .env and fill in.
# Setup: https://developer.chrome.com/docs/webstore/using-api
#
# 1. Google Cloud: enable "Chrome Web Store API"
# 2. OAuth client (Web application), redirect URI:
#    https://developers.google.com/oauthplayground
# 3. OAuth Playground: scope https://www.googleapis.com/auth/chromewebstore
#    Authorize, then exchange for a refresh token
# 4. Dashboard → Publisher → Settings: publisher ID
# 5. Item URL …/detail/<extension-id> or the item page in the dashboard

CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_PUBLISHER_ID=
CWS_EXTENSION_ID=
